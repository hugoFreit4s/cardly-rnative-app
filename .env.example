# Optional — local dev falls back to localhost:8080 (web/iOS) or 10.0.2.2:8080 (Android emulator).
# Copy to .env only when you need a custom API URL (e.g. physical device on LAN).

# Web / iOS simulator / Docker frontend (nginx on :3000)
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Android emulator
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080

# Physical device on the same Wi-Fi (replace with your machine IP)
# EXPO_PUBLIC_API_BASE_URL=http://192.168.0.10:8080

# Google SSO (optional — login button stays hidden when empty)
# EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
